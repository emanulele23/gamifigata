# === Echo — Personal Life & Health Agent ===
# Copia questo file:  cp .env.example .env
# Poi compila i valori. Non committare mai .env

# --- Telegram Bot (obbligatorio per chat / note vocali) ---
TELEGRAM_BOT_TOKEN=
# Opzionale se STANDALONE_BOT=true: viene appreso al primo messaggio
TELEGRAM_CHAT_ID=

# --- DeepSeek LLM (obbligatorio) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Fish Audio: TTS + ASR (obbligatorio) ---
# Una sola chiave per voce e trascrizione. Niente OpenAI Whisper.
FISH_API_KEY=
# ID del modello voce clonato su fish.audio (reference_id)
FISH_REFERENCE_ID=
FISH_TTS_MODEL=s2.1-pro
FISH_TTS_FORMAT=ogg

# --- echo-api ---
ECHO_API_HOST=0.0.0.0
ECHO_API_PORT=5000
# Timezone per cron promemoria (Europe/Rome tipico)
TZ=Europe/Rome
# Orari promemoria (HH:MM, separati da virgola)
REMINDER_TIMES=13:30,21:00
# Promemoria gestiti da echo-api (metti false se usi i cron di n8n)
ENABLE_INTERNAL_REMINDERS=true
# Se true, echo-api gestisce anche il bot Telegram in polling (senza n8n)
STANDALONE_BOT=true
# Se true, ai promemoria tenta anche una chiamata vocale Telegram
ENABLE_VOICE_CALLS=false

# --- Chiamate vocali Telegram via Pyrogram (opzionale, Fase 5) ---
# Crea app su https://my.telegram.org → api_id / api_hash
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Username o user id del tuo account principale da chiamare
TELEGRAM_CALL_TARGET=
# Path sessione userbot (montata nel volume)
TELEGRAM_SESSION_PATH=/app/data/echo_userbot

# --- n8n ---
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
# Imposta una password al primo avvio dalla UI n8n
GENERIC_TIMEZONE=Europe/Rome
