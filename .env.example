# === Echo — Personal Life & Health Agent ===
# Esegui: python3 scripts/onboard.py  (consigliato alla prima installazione)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Fish Audio (TTS + ASR) ---
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_TTS_MODEL=s2.1-pro
FISH_TTS_FORMAT=ogg

# --- Check-in vocali 2-3x/giorno ---
TZ=Europe/Rome
REMINDER_TIMES=09:00,14:00,21:00
ENABLE_INTERNAL_REMINDERS=true
STANDALONE_BOT=true
ENABLE_VOICE_CALLS=true
PREFER_CALLS_ON_CHECKIN=true

# --- Chiamate Telegram (userbot) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CALL_TARGET=
TELEGRAM_SESSION_PATH=/app/data/echo_userbot

# --- Apple Salute (Shortcut iPhone → webhook) ---
APPLE_HEALTH_SECRET=
ECHO_PUBLIC_URL=http://IP_RASPI:5000

# --- n8n (opzionale) ---
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Europe/Rome
